---
interface Props {
  intro: string;
  emailHeading: string;
  emailDescription: string;
  composeLabel: string;
  copyLabel: string;
  copiedLabel: string;
  copyFailedLabel: string;
  subject: string;
  fields: string[];
  communityHeading: string;
  githubDescription: string;
  githubLabel: string;
  xDescription: string;
  xLabel: string;
  reportHeading: string;
  reportDetails: string[];
  templateHeading: string;
  copyTemplateLabel: string;
  templateCopiedLabel: string;
  templateCopyFailedLabel: string;
  helpHeading: string;
  quickStartLabel: string;
  installationLabel: string;
  tutorialsLabel: string;
}

const copy = Astro.props;
const localeHome = Astro.locals.starlightRoute.siteTitleHref;
const email = 'ronktsang@gmail.com';
const template = copy.fields.join('\n\n');
const body = copy.fields.join('\r\n\r\n') + '\r\n';
const mailto = `mailto:${email}?subject=${encodeURIComponent(copy.subject)}&body=${encodeURIComponent(body)}`;
---

<div class="support-content">
  <p class="intro">{copy.intro}</p>

  <section class="email-card" aria-labelledby="email-support">
    <h2 id="email-support">
      <svg class="section-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
      {copy.emailHeading}
    </h2>
    <p>{copy.emailDescription}</p>
    <a id="support-email-address" class="email-address" href={mailto}>{email}</a>
    <div class="actions">
      <a class="primary-action" href={mailto}>{copy.composeLabel}<span aria-hidden="true">↗</span></a>
      <button
        type="button"
        command="--copy-support"
        commandfor="support-email-address"
        data-copy-status="support-email-status"
        data-success={copy.copiedLabel}
        data-failure={copy.copyFailedLabel}
        hidden
      >{copy.copyLabel}</button>
    </div>
    <p id="support-email-status" class="copy-status" role="status"></p>
  </section>

  <section aria-labelledby="community">
    <h2 id="community">{copy.communityHeading}</h2>
    <div class="community-cards not-content">
      <div class="community-card">
        <h3>
          <svg class="section-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C6.48 2 2 6.58 2 12.23c0 4.52 2.87 8.35 6.84 9.7.5.1.68-.22.68-.49 0-.24-.01-1.04-.01-1.89-2.78.62-3.37-1.2-3.37-1.2-.45-1.18-1.11-1.49-1.11-1.49-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.9 1.57 2.35 1.12 2.92.86.09-.67.35-1.12.64-1.38-2.22-.26-4.56-1.15-4.56-5.11 0-1.13.39-2.05 1.04-2.78-.1-.26-.45-1.31.1-2.74 0 0 .85-.28 2.75 1.06A9.3 9.3 0 0 1 12 6.3c.85 0 1.71.12 2.51.35 1.91-1.34 2.75-1.06 2.75-1.06.55 1.43.2 2.48.1 2.74.65.73 1.04 1.65 1.04 2.78 0 3.97-2.35 4.84-4.58 5.1.36.32.68.93.68 1.88 0 1.36-.01 2.45-.01 2.78 0 .27.18.6.69.49A10.22 10.22 0 0 0 22 12.23C22 6.58 17.52 2 12 2Z" /></svg>
          GitHub
        </h3>
        <p>{copy.githubDescription}</p>
        <a href="https://github.com/RonkTsang/ai-mode-exporter/issues">{copy.githubLabel} <span aria-hidden="true">↗</span></a>
      </div>
      <div class="community-card">
        <h3>
          <svg class="section-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M18.9 2H22l-6.78 7.75L23.2 22h-6.25l-4.9-7.12L5.8 22H2.7l7.25-8.29L2.3 2h6.4l4.43 6.5L18.9 2Zm-1.09 18h1.72L7.76 3.9H5.91L17.81 20Z" /></svg>
          X
        </h3>
        <p>{copy.xDescription}</p>
        <a href="https://x.com/RonkTsang">{copy.xLabel} <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section aria-labelledby="report-details">
    <h2 id="report-details">{copy.reportHeading}</h2>
    <ul>{copy.reportDetails.map(detail => <li>{detail}</li>)}</ul>
    <div class="feedback-template">
      <h3>{copy.templateHeading}</h3>
      <pre><code id="support-feedback-template">{template}</code></pre>
      <button
        type="button"
        command="--copy-support"
        commandfor="support-feedback-template"
        data-copy-status="support-template-status"
        data-success={copy.templateCopiedLabel}
        data-failure={copy.templateCopyFailedLabel}
        hidden
      >{copy.copyTemplateLabel}</button>
      <p id="support-template-status" class="copy-status" role="status"></p>
    </div>
  </section>

  <section aria-labelledby="self-help">
    <h2 id="self-help">{copy.helpHeading}</h2>
    <ul class="help-links" role="list">
      <li><a href={`${localeHome}guide/quick-start/`}>{copy.quickStartLabel}</a></li>
      <li><a href={`${localeHome}guide/install-and-troubleshoot/`}>{copy.installationLabel}</a></li>
      <li><a href={`${localeHome}blog/`}>{copy.tutorialsLabel}</a></li>
    </ul>
  </section>
</div>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy-status]')) {
    const target = document.getElementById(button.getAttribute('commandfor') ?? '');
    const status = document.getElementById(button.dataset.copyStatus ?? '');
    if (!target || !status) continue;

    let resetStatus: number | undefined;
    let lastMessage = '';

    const copyText = async (): Promise<void> => {
      let message = button.dataset.success ?? '';
      try {
        await navigator.clipboard.writeText(target.textContent?.trim() ?? '');
      } catch {
        message = button.dataset.failure ?? '';
      }

      window.clearTimeout(resetStatus);
      // Vary repeated messages so VoiceOver announces consecutive attempts.
      const announcement = message === lastMessage ? message + '\u00a0' : message;
      lastMessage = announcement;
      status.textContent = announcement;
      resetStatus = window.setTimeout(() => {
        status.textContent = '';
      }, 4000);
    };

    if ('CommandEvent' in window) {
      target.addEventListener('command', (event) => {
        if (event instanceof CommandEvent && event.command === '--copy-support') void copyText();
      });
    } else {
      button.addEventListener('click', copyText);
    }
    button.hidden = false;
  }
</script>

<style>
  :global(html:has(.support-content)) {
    --sl-content-width: 45rem;
  }

  .support-content {
    max-inline-size: 48rem;
  }

  .support-content .intro {
    font-size: 1.15rem;
    color: var(--sl-color-gray-2);
  }

  .support-content section {
    margin-block-start: 2.5rem;
  }

  .support-content h2 {
    font-size: 1.45rem;
    margin-block-start: 0;
  }

  .support-content h3 {
    font-size: 1.1rem;
    margin-block-start: 0;
  }

  .email-card h2, .community-card h3 {
    display: flex;
    align-items: center;
    gap: 0.45em;
  }

  .section-icon {
    width: 1.1em;
    height: 1.1em;
    flex: 0 0 auto;
    fill: currentColor;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .email-card .section-icon {
    fill: none;
    stroke-width: 1.8;
  }

  .email-card {
    padding: clamp(1.25rem, 4vw, 2rem);
    border: 1px solid var(--sl-color-accent);
    border-radius: 1rem;
    background: var(--sl-color-accent-low);
  }

  .email-address {
    display: inline-block;
    margin-block-start: 1rem;
    font-size: clamp(1rem, 3vw, 1.35rem);
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-start: 1.25rem;
  }

  .actions > * {
    margin-block-start: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    min-block-size: 2.75rem;
    padding: 0.6rem 1rem;
    border-radius: 0.5rem;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
  }

  .actions .primary-action {
    background: var(--sl-color-text-accent);
    color: var(--sl-color-bg);
    border: 1px solid transparent;
  }

  .actions button {
    background: transparent;
    color: var(--sl-color-text);
    border: 1px solid currentColor;
  }

  .support-content button[hidden] {
    display: none;
  }

  .actions > *:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .support-content :is(a, button):focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 4px;
  }

  .support-content .copy-status {
    font-size: var(--sl-text-sm);
    margin-block: 0;
  }

  .support-content .copy-status:not(:empty) {
    margin-block-start: 1rem;
  }

  .feedback-template {
    margin-block-start: 1.5rem;
    padding: 1.25rem;
    border: 1px solid var(--sl-color-hairline-shade);
    border-radius: 0.75rem;
  }

  .feedback-template h3 {
    margin-block-end: 0.25rem;
  }

  .feedback-template pre {
    margin: 1rem 0;
    padding: 1rem;
    border: 1px solid var(--sl-color-hairline-shade);
    border-radius: 0.5rem;
    background: var(--sl-color-bg);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .feedback-template button {
    min-block-size: 2.5rem;
    padding: 0.5rem 0.875rem;
    border: 1px solid currentColor;
    border-radius: 0.5rem;
    background: transparent;
    color: var(--sl-color-text);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .community-cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: stretch;
    gap: 1rem;
  }

  .community-cards > .community-card {
    display: flex;
    min-block-size: 100%;
    margin-block-start: 0;
    box-sizing: border-box;
    flex-direction: column;
    padding: 1.25rem;
    border: 1px solid var(--sl-color-hairline-shade);
    border-radius: 0.75rem;
  }

  .community-card > a {
    margin-block-start: auto;
  }

  .help-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    padding: 0;
    list-style: none;
  }

  .help-links li {
    margin: 0;
  }

  @media (max-width: 36rem) {
    .community-cards {
      grid-template-columns: 1fr;
    }
  }
</style>
