---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import googleLogo from '../assets/branding/google-g.png';

interface Props {
  copy: { sourceLabel: string; continueLabel: string };
  destinations: { name: string; logo: ImageMetadata }[];
}

const { copy, destinations } = Astro.props;
---

<div class="continue-preview">
  <p class="node source">
    <span class="source-mark"><Image src={googleLogo} width={48} height={48} alt="" /></span>
    <span>{copy.sourceLabel}</span>
  </p>

  <p class="sr-only">{copy.continueLabel}</p>
  <div class="routes" aria-hidden="true">
    <span class="trace upper"></span>
    <span class="trace lower"></span>
    <span class="signal upper"></span>
    <span class="signal lower"></span>
  </div>

  <ul class="targets" role="list">
    {destinations.map(({ name, logo }) => (
      <li class="node">
        <Image src={logo} width={30} height={30} fit="contain" alt="" />
        <span>{name}</span>
      </li>
    ))}
  </ul>
</div>

<style>
  .continue-preview {
    --target-gap: clamp(0.6rem, 3cqw, 1rem);
    --upper-y: calc(25% - var(--target-gap) / 4);
    --lower-y: calc(75% + var(--target-gap) / 4);
    --wire: color-mix(in srgb, var(--home-accent) 47%, var(--home-surface));
    --signal-color: var(--home-accent);
    --send-duration: 1.48s;
    --first-send: 0.2s;
    --second-send: 1.82s;

    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(1.85rem, 16cqw, 6rem) minmax(0, 1fr);
    align-items: center;
    align-content: center;
    min-block-size: clamp(13.25rem, 64cqw, 23rem);
    padding: clamp(0.75rem, 7cqw, 2.4rem);
    background:
      radial-gradient(ellipse at 48% 52%, color-mix(in srgb, var(--home-accent) 10%, transparent), transparent 70%),
      color-mix(in srgb, var(--home-surface) 86%, transparent);
    color: var(--home-ink);
  }

  .node {
    position: relative;
    min-inline-size: 0;
    border: 1px solid var(--home-border);
    background: var(--home-surface);
    text-align: center;
    font-weight: 710;
    overflow-wrap: anywhere;
  }

  .source {
    display: grid;
    justify-items: center;
    gap: clamp(0.32rem, 2cqw, 0.75rem);
    padding: clamp(0.65rem, 4cqw, 1.4rem) clamp(0.4rem, 2cqw, 0.85rem);
    border-radius: clamp(0.8rem, 4cqw, 1.4rem);
    box-shadow: 0 12px 26px color-mix(in srgb, var(--home-accent) 12%, transparent);
    font-size: clamp(0.83rem, 3.65cqw, 1.2rem);
    line-height: 1.28;
  }

  .source > span:last-child {
    word-break: keep-all;
    text-wrap: balance;
  }

  .source-mark {
    display: grid;
    place-items: center;
    inline-size: clamp(2.1rem, 11cqw, 3.6rem);
    aspect-ratio: 1;
    border: 1px solid #c4d4ed80;
    border-radius: 32%;
    background: #fff;
  }

  .source-mark img {
    inline-size: 60%;
    block-size: auto;
  }

  .routes {
    position: relative;
    align-self: stretch;
    pointer-events: none;
  }

  .routes::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 50%;
    inline-size: 50%;
    block-size: 1px;
    background: var(--wire);
  }

  .trace {
    position: absolute;
    inset-inline: 50% 0;
    border-inline-start: 1px solid var(--wire);
  }

  .trace.upper {
    inset-block: var(--upper-y) 50%;
    border-block-start: 1px solid var(--wire);
    border-start-start-radius: 0.5rem;
  }

  .trace.lower {
    inset-block: 50% calc(100% - var(--lower-y));
    border-block-end: 1px solid var(--wire);
    border-end-start-radius: 0.5rem;
  }

  .targets {
    display: grid;
    grid-template-rows: repeat(2, 1fr);
    align-self: stretch;
    gap: var(--target-gap);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .targets li {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.25rem 0.48rem;
    min-block-size: clamp(2.9rem, 13cqw, 4.1rem);
    padding: 0.43rem clamp(0.3rem, 2cqw, 0.8rem);
    border-radius: clamp(0.68rem, 3cqw, 1.05rem);
    font-size: clamp(0.8rem, 3.35cqw, 1.11rem);
    line-height: 1.2;
  }

  .targets img {
    flex: none;
    inline-size: clamp(1.25rem, 5.5cqw, 1.82rem);
    block-size: auto;
  }

  .source::after,
  .targets li::before {
    content: '';
    position: absolute;
    inset-block-start: 50%;
    inline-size: 0.34rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--wire);
  }

  .source::after {
    inset-inline-end: 0;
    transform: translate(50%, -50%);
  }

  .targets li::before {
    inset-inline-start: 0;
    transform: translate(-50%, -50%);
  }

  .signal {
    position: absolute;
    inset: 0;
    z-index: 1;
    opacity: 0;
  }

  .signal::before {
    content: '';
    position: absolute;
    inset: 0 auto auto 0;
    inline-size: 0.46rem;
    aspect-ratio: 1;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    background: var(--signal-color);
    box-shadow: 0 0 0.65rem var(--signal-color);
  }

  @media (prefers-reduced-motion: no-preference) {
    .signal.upper {
      --arrival-y: var(--upper-y);
      animation: travel var(--send-duration) linear var(--first-send) both;
    }

    .signal.lower {
      --arrival-y: var(--lower-y);
      animation: travel var(--send-duration) linear var(--second-send) both;
    }

    .targets li::after {
      content: '';
      position: absolute;
      inset: -1px;
      border: 1px solid var(--signal-color);
      border-radius: inherit;
      opacity: 0;
      pointer-events: none;
      animation: receive 0.58s ease-out calc(var(--start) + var(--send-duration) - 0.08s) both;
    }

    .targets li:first-child {
      --start: var(--first-send);
    }

    .targets li:last-child {
      --start: var(--second-send);
    }
  }

  @keyframes travel {
    0% { opacity: 0; transform: translate(0, 50%); }
    7% { opacity: 1; }
    36% { transform: translate(50%, 50%); }
    66% { transform: translate(50%, var(--arrival-y)); }
    95% { opacity: 1; }
    100% { opacity: 0; transform: translate(100%, var(--arrival-y)); }
  }

  @keyframes receive {
    from { opacity: 0.85; transform: scale(1); }
    to { opacity: 0; transform: scale(1.04); }
  }
</style>
